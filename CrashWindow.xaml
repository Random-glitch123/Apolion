<Window x:Class="Apolion.CrashWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Apolion Crash Assistant"
        Width="780" Height="600"
        MinWidth="620" MinHeight="440"
        WindowStartupLocation="CenterScreen"
        Background="#FF171B24"
        Foreground="#FFE8ECF4"
        Topmost="True"
        ShowInTaskbar="True">
    <Grid Margin="22">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Grid Grid.Row="0" Margin="0,0,0,14">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <Border Width="46" Height="46" CornerRadius="23"
                    Background="#FF7A2E2E" VerticalAlignment="Top">
                <TextBlock Text="!"
                           FontSize="28"
                           FontWeight="Bold"
                           Foreground="#FFFFD9D9"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center"/>
            </Border>

            <StackPanel Grid.Column="1" Margin="14,0,0,0">
                <TextBlock Text="Apolion hit a problem"
                           FontSize="22"
                           FontWeight="SemiBold"/>
                <TextBlock x:Name="SummaryText"
                           Margin="0,6,0,0"
                           FontSize="13"
                           TextWrapping="Wrap"
                           Foreground="#FFB7C0D0"/>
            </StackPanel>
        </Grid>

        <!-- Explanation -->
        <Border Grid.Row="1"
                Background="#FF202635"
                BorderBrush="#FF2E374B"
                BorderThickness="1"
                CornerRadius="6"
                Padding="12"
                Margin="0,0,0,12">
            <TextBlock TextWrapping="Wrap" FontSize="12.5" Foreground="#FFC9D2E2">
                A crash report with technical details was saved automatically.
                Please use <Run FontWeight="Bold">Send report</Run> (or
                <Run FontWeight="Bold">Copy details</Run>) and send it to the developer so the
                problem can be fixed. Your browsing data is not included.
            </TextBlock>
        </Border>

        <!-- Details -->
        <TextBox x:Name="DetailsBox"
                 Grid.Row="2"
                 IsReadOnly="True"
                 AcceptsReturn="True"
                 TextWrapping="NoWrap"
                 VerticalScrollBarVisibility="Auto"
                 HorizontalScrollBarVisibility="Auto"
                 FontFamily="Consolas"
                 FontSize="11.5"
                 Background="#FF10141C"
                 Foreground="#FFD6DEEB"
                 BorderBrush="#FF2E374B"
                 BorderThickness="1"
                 Padding="10"/>

        <!-- Footer -->
        <Grid Grid.Row="3" Margin="0,14,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <TextBlock x:Name="LogPathText"
                       FontSize="11"
                       Foreground="#FF8C97A8"
                       TextTrimming="CharacterEllipsis"
                       VerticalAlignment="Center"
                       Margin="0,0,12,0"/>

            <StackPanel Grid.Column="1" Orientation="Horizontal">
                <Button x:Name="BtnCopy" Content="Copy details" Padding="12,7" Margin="0,0,8,0"
                        Background="#FF2D3547" Foreground="#FFE8ECF4" BorderBrush="#FF3D4860"
                        Click="BtnCopy_Click"/>
                <Button x:Name="BtnOpenLogs" Content="Open log folder" Padding="12,7" Margin="0,0,8,0"
                        Background="#FF2D3547" Foreground="#FFE8ECF4" BorderBrush="#FF3D4860"
                        Click="BtnOpenLogs_Click"/>
                <Button x:Name="BtnEmail" Content="Send report" Padding="12,7" Margin="0,0,8,0"
                        Background="#FF2F6FEB" Foreground="White" BorderBrush="#FF2F6FEB"
                        Click="BtnEmail_Click"/>
                <Button x:Name="BtnRestart" Content="Restart" Padding="12,7" Margin="0,0,8,0"
                        Background="#FF2D3547" Foreground="#FFE8ECF4" BorderBrush="#FF3D4860"
                        Click="BtnRestart_Click"/>
                <Button x:Name="BtnClose" Content="Close" Padding="12,7"
                        Background="#FF2D3547" Foreground="#FFE8ECF4" BorderBrush="#FF3D4860"
                        Click="BtnClose_Click"/>
            </StackPanel>
        </Grid>
    </Grid>
</Window>

