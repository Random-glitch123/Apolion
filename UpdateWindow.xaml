<Window x:Class="Apolion.UpdateWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="Apolion Update"
        Height="420" Width="520"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ShowInTaskbar="False"
        Topmost="True">
    
    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="App.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Window.Resources>

    <Border Background="{DynamicResource WindowBackground}"
            BorderBrush="{DynamicResource BorderBrush}"
            BorderThickness="1"
            CornerRadius="8"
            Effect="{DynamicResource WindowShadowEffect}">
        
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Title Bar -->
            <Border x:Name="TitleBar"
                    Grid.Row="0"
                    Height="40"
                    Background="{DynamicResource TitleBarBackground}"
                    CornerRadius="8,8,0,0"
                    MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <Image Source="apolion.ico" Width="20" Height="20" Margin="12,0,8,0" Grid.Column="0"/>
                    <TextBlock Text="Apolion Update" 
                               VerticalAlignment="Center" 
                               FontWeight="SemiBold"
                               Foreground="{DynamicResource ForegroundBrush}"
                               Grid.Column="1"/>

                    <Button x:Name="BtnClose"
                            Grid.Column="2"
                            Width="36" Height="36"
                            Margin="0,2,8,2"
                            Style="{DynamicResource TitleBarButtonStyle}"
                            Click="BtnClose_Click"
                            ToolTip="Close">
                        <TextBlock Text="&#xE711;" FontFamily="Segoe Fluent Icons" FontSize="12" Foreground="{DynamicResource ForegroundBrush}"/>
                    </Button>
                </Grid>
            </Border>

            <!-- Content -->
            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="24,20,24,10">
                <StackPanel>
                    <!-- Icon and Title -->
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,0,0,16">
                        <Border Width="64" Height="64" 
                                Background="{DynamicResource AccentBrush}"
                                CornerRadius="12"
                                Effect="{DynamicResource GlowEffect}">
                            <TextBlock Text="&#xE70A;" 
                                       FontFamily="Segoe Fluent Icons" 
                                       FontSize="28" 
                                       Foreground="White"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center"/>
                        </Border>
                    </StackPanel>

                    <TextBlock x:Name="TxtTitle"
                               Text="Update Available"
                               FontSize="22"
                               FontWeight="SemiBold"
                               Foreground="{DynamicResource ForegroundBrush}"
                               HorizontalAlignment="Center"
                               TextAlignment="Center"
                               Margin="0,0,0,8"/>

                    <TextBlock x:Name="TxtVersionInfo"
                               Text="Version 1.0.0 is available (you have 0.9.3)"
                               FontSize="13"
                               Foreground="{DynamicResource SecondaryForegroundBrush}"
                               HorizontalAlignment="Center"
                               TextAlignment="Center"
                               Margin="0,0,0,20"/>

                    <!-- Release Notes -->
                    <Border x:Name="ReleaseNotesBorder"
                            Background="{DynamicResource ControlBackground}"
                            BorderBrush="{DynamicResource BorderBrush}"
                            BorderThickness="1"
                            CornerRadius="6"
                            Padding="14"
                            Margin="0,0,0,20"
                            Visibility="Collapsed">
                        <StackPanel>
                            <TextBlock Text="What's New"
                                       FontSize="13"
                                       FontWeight="SemiBold"
                                       Foreground="{DynamicResource ForegroundBrush}"
                                       Margin="0,0,0,8"/>
                            <TextBlock x:Name="TxtReleaseNotes"
                                       Text="Loading release notes..."
                                       FontSize="12"
                                       Foreground="{DynamicResource SecondaryForegroundBrush}"
                                       TextWrapping="Wrap"
                                       LineHeight="18"/>
                        </StackPanel>
                    </Border>

                    <!-- Progress Section (shown during download) -->
                    <StackPanel x:Name="ProgressPanel" Visibility="Collapsed" Margin="0,0,0,16">
                        <TextBlock x:Name="TxtProgressStatus"
                                   Text="Downloading update..."
                                   FontSize="13"
                                   Foreground="{DynamicResource ForegroundBrush}"
                                   Margin="0,0,0,8"
                                   HorizontalAlignment="Center"/>
                        <ProgressBar x:Name="ProgressBar"
                                     Height="6"
                                     Minimum="0" Maximum="1"
                                     Value="0"
                                     Background="{DynamicResource ControlBackground}"
                                     Foreground="{DynamicResource AccentBrush}"
                                     BorderThickness="0"/>
                        <TextBlock x:Name="TxtProgressDetail"
                                   Text="0%"
                                   FontSize="11"
                                   Foreground="{DynamicResource SecondaryForegroundBrush}"
                                   HorizontalAlignment="Center"
                                   Margin="0,6,0,0"/>
                    </StackPanel>

                    <!-- Info text -->
                    <TextBlock x:Name="TxtInfo"
                               Text="Your settings, language, bookmarks and saved tabs are preserved. The browser cache and EULA acceptance are reset so the new version starts cleanly. Apolion will restart automatically."
                               FontSize="12"
                               Foreground="{DynamicResource SecondaryForegroundBrush}"
                               TextWrapping="Wrap"
                               TextAlignment="Center"
                               LineHeight="16"/>
                </StackPanel>
            </ScrollViewer>

            <!-- Buttons -->
            <Border Grid.Row="2" Background="{DynamicResource TitleBarBackground}" CornerRadius="0,0,8,8" Padding="16,12">
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button x:Name="BtnLater"
                            Content="Remind Me Later"
                            Style="{DynamicResource SecondaryButtonStyle}"
                            MinWidth="120"
                            Height="36"
                            Margin="0,0,10,0"
                            Click="BtnLater_Click"/>
                    <Button x:Name="BtnUpdate"
                            Content="Download &amp; Update"
                            Style="{DynamicResource PrimaryButtonStyle}"
                            MinWidth="140"
                            Height="36"
                            Click="BtnUpdate_Click"/>
                </StackPanel>
            </Border>
        </Grid>
    </Border>
</Window>
